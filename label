#!/usr/bin/env bash
# Adjudicate cases from anywhere.
#
#   ./label ambiguous_003              both phases
#   ./label ambiguous_003 --phase forbidden
#   ./label                            list what still needs work
#
# Resolves the repo root from its own location, so the working directory does not
# matter -- `python -m src.cli` otherwise needs the root on sys.path.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$ROOT/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "no venv at $PY -- run: python3 -m venv .venv && ./.venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  cd "$ROOT" && exec "$PY" -m src.cli status
fi

cd "$ROOT"
exec "$PY" -m src.cli prelabel --case "$@"
